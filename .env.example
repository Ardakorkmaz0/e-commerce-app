# Copy this file to .env and fill in real values. Never commit .env itself.

# PostgreSQL (also read by compose.yaml)
POSTGRES_DB=ecommerce_dev
POSTGRES_USER=ecommerce_app
POSTGRES_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433

# Django
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Never enable in production.
DEBUG=True

# Comma separated. 10.0.2.2 is the host machine as seen from the Android emulator.
# Optional in development — defaults to 127.0.0.1,localhost,10.0.2.2
# ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
